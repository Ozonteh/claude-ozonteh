---
// Pagină de categorie (buldoexcavatoare / încărcătoare frontale / skid steer): modelele, textul SEO, FAQ.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';
import ProductGrid from '../components/pages/ProductGrid.astro';
import TextBlock from '../components/pages/TextBlock.astro';
import CompareTray from '../components/pages/CompareTray.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Icon from '../components/ui/Icon.astro';
import { byCategory } from '../lib/products';
import { asset } from '../lib/images';
import { getPage, crumbs } from '../lib/pages';
import { breadcrumbGraph, faqGraph, itemListGraph } from '../lib/schema';
import { CATEGORY_SLUGS, categoryPath, route, type CategoryId, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; cat: CategoryId }
const { lang, cat } = Astro.props;
const ui = t(lang);
const c = ui.pages.category;
const page = await getPage(cat, lang);
const list = byCategory(cat);
const site = Astro.site ?? new URL(Astro.url.origin);
const cr = crumbs(site, lang, [
  { name: ui.nav.machines, path: route('catalog', lang) },
  { name: ui.categories[cat].plural, path: categoryPath(cat, lang) },
]);
const covers: Record<CategoryId, string> = {
  buldoexcavatoare: 'santier/buldoexcavator-bull-hd100-sapare-retele.webp',
  'incarcatoare-frontale': 'santier/incarcator-frontal-bull-hd76-cariera-piatra.webp',
  'miniincarcatoare-skid-steer': 'santier/miniincarcator-skid-steer-bull-av490-lucru.webp',
};
const others = (Object.keys(CATEGORY_SLUGS) as CategoryId[]).filter((x) => x !== cat);
const jsonld = [breadcrumbGraph(cr), itemListGraph(list, site, lang), ...(page.faq?.length ? [faqGraph(page.faq)] : [])];
---

<BaseLayout
  lang={lang}
  title={page.seoTitle}
  description={page.seoDescription}
  alternates={{ ro: categoryPath(cat, 'ro'), ru: categoryPath(cat, 'ru') }}
  ogImage={asset(covers[cat])}
  ogImageAlt={page.h1}
  jsonld={jsonld}
>
  <PageHero lang={lang} crumbs={cr} eyebrow={c.eyebrow} title={page.h1} lead={page.lead} image={covers[cat]} imageAlt={page.h1} />

  <section class="catp on-dark" aria-labelledby="catp-models">
    <div class="wrap">
      <h2 id="catp-models" class="t-eyebrow catp-title"><span class="idx">01</span> {c.models} · {list.length}</h2>
      <ProductGrid list={list} lang={lang} />
      {
        list.length > 1 && (
          <a href={`${route('compare', lang)}?m=${list.slice(0, 3).map((p) => p.id).join(',')}`} class="link-arrow catp-compare">
            {c.compare} <Icon name="arrow" size={18} />
          </a>
        )
      }
    </div>
  </section>

  {
    page.blocks.intro && (
      <section class="on-light section">
        <div class="wrap">
          <TextBlock title={page.blocks.intro.title} text={page.blocks.intro.text} eyebrow={ui.categories[cat].plural} idx="02" />
        </div>
      </section>
    )
  }

  {page.faq?.length && <Faq lang={lang} items={page.faq} idx="03" />}

  <section class="catp-other on-graphite" aria-labelledby="catp-other">
    <div class="wrap catp-other-inner">
      <h2 id="catp-other" class="t-eyebrow"><span class="idx">04</span> {c.other}</h2>
      <ul class="catp-links" role="list">
        {
          others.map((o) => (
            <li>
              <a href={categoryPath(o, lang)} class="catp-link">
                <span>{ui.categories[o].plural}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        <li>
          <a href={route('catalog', lang)} class="catp-link">
            <span>{ui.nav.catalog}</span>
            <Icon name="arrow" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <FinalCta lang={lang} idx="05" model={list.length === 1 ? list[0].id : undefined} />
  <CompareTray lang={lang} />
</BaseLayout>

<script>
  import '../scripts/catalog';
</script>

<style>
  .catp { padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(4rem, 3rem + 4vw, 7rem); }
  .catp-title { margin-bottom: 1.25rem; }
  .catp-compare { margin-top: 1.5rem; }
  .catp-other { padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .catp-other-inner { display: grid; gap: 1.25rem; }
  .catp-links { display: grid; gap: 1px; background: var(--color-line); box-shadow: 0 0 0 1px var(--color-line); }
  .catp-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
    padding: 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: var(--display-track);
    background: var(--color-graphite);
    transition: background-color 0.25s, color 0.25s;
  }
  :global(html:lang(ru)) .catp-link { font-weight: 600; font-size: 1.25rem; }
  .catp-link:hover { color: var(--color-asphalt); background: var(--color-bull-yellow); }
  @media (min-width: 48rem) {
    .catp-links { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
