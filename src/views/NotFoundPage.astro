---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { products } from '../lib/products';
import { asset } from '../lib/images';
import { route, productPath, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const n = ui.notFound;
const picks = products.filter((p) => ['bull-sd76-super-smart', 'bull-hd-100', 'bull-av490'].includes(p.id));
---

<BaseLayout
  lang={lang}
  title={`${n.title} | ${ui.meta.siteName}`}
  description={n.text}
  alternates={{ ro: '/', ru: '/ru/' }}
  ogImage={asset('santier/buldoexcavator-bull-ch76-santier-moldova.webp')}
  ogImageAlt={ui.meta.ogAlt}
  noindex
>
  {
    lang === 'ro' && (
      <script is:inline slot="head">
        if (/^\/ru(\/|$)/.test(location.pathname) && !location.pathname.startsWith('/ru/404')) location.replace('/ru/404/');
      </script>
    )
  }
  <section class="nf on-dark blueprint">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="t-eyebrow"><span class="idx">404</span> {n.code}</p>
        <h1 class="t-hero nf-title">{n.title}</h1>
        <p class="t-lead">{n.text}</p>
        <div class="nf-cta">
          <a href={route('home', lang)} class="btn btn-primary btn-lg">{n.back} <Icon name="arrow" class="arrow" /></a>
          <a href={route('catalog', lang)} class="btn btn-outline btn-lg">{ui.cta.allMachines}</a>
        </div>
      </div>
      <p class="nf-code t-num" aria-hidden="true">4<span class="hl">0</span>4</p>
    </div>
    <div class="wrap">
      <ul class="nf-models" role="list">
        {
          picks.map((p) => (
            <li>
              <a href={productPath(p, lang)} class="nf-model">
                <Image src={asset(p.image)} alt={p.alt[lang]} widths={[300, 480]} sizes="(min-width: 768px) 30vw, 80vw" loading="lazy" />
                <span class="t-mono">{p.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  .nf { padding-top: calc(var(--header-h) + 3rem); }
  .nf-grid { display: grid; gap: 2rem; align-items: center; min-height: 52vh; }
  .nf-copy { display: grid; gap: 1.25rem; }
  .nf-title { font-size: calc(clamp(3rem, 1.8rem + 5vw, 7rem) * var(--display-scale)); line-height: 1.08; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 0.5rem; }
  .nf-code { font-size: clamp(8rem, 5rem + 18vw, 22rem); color: transparent; -webkit-text-stroke: 2px rgb(231 228 221 / 0.25); line-height: 0.8; }
  .nf-code .hl { -webkit-text-stroke: 0; color: var(--color-bull-yellow); }
  .nf-models { display: grid; gap: 10px; margin-block: 3rem 4rem; }
  .nf-model { display: grid; gap: 0.5rem; padding: 1rem; background: var(--color-graphite); box-shadow: inset 0 0 0 1px var(--color-line); transition: box-shadow 0.25s; }
  .nf-model:hover { box-shadow: inset 0 0 0 1px var(--color-bull-yellow); }
  .nf-model :global(img) { width: 100%; height: auto; }
  .nf-model span { font-size: 0.8125rem; color: var(--color-steel); }
  @media (min-width: 48rem) {
    .nf-models { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .nf-grid { grid-template-columns: 1.3fr 1fr; }
    .nf-code { justify-self: end; }
  }
</style>
