---
// Configurator de cupe: grilă cu cele 19 cupe și atașamente. La hover (desktop) sau tap (mobil)
// imaginea mare se schimbă cu crossfade și apare descrierea. O singură imagine mare se încarcă odată.
import { Image, getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import AttachmentDrawing from './AttachmentDrawing.astro';
import { attachments } from '../../data/attachments';
import { asset } from '../../lib/images';
import { route, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const c = ui.home.configurator;
const forLabel = {
  backhoe: ui.categories.buldoexcavatoare.plural,
  loader: ui.categories['incarcatoare-frontale'].plural,
  skid: ui.categories['miniincarcatoare-skid-steer'].plural,
};

const items = await Promise.all(
  attachments.map(async (a) => {
    let src = '';
    let srcset = '';
    if (a.image) {
      const meta = asset(a.image);
      const ws = [480, 800];
      const imgs = await Promise.all(ws.map((w) => getImage({ src: meta, width: w, format: 'webp', quality: 74 })));
      src = imgs[1].src;
      srcset = imgs.map((im, i) => `${im.src} ${ws[i]}w`).join(', ');
    }
    return { ...a, src, srcset, compat: a.for.map((f) => forLabel[f]) };
  })
);
const first = items[0];
---

<section class="cfg section on-light blueprint cv-auto" aria-labelledby="cfg-title" data-cfg>
  <div class="wrap">
    <div class="section-head split">
      <div class="cfg-titles" data-reveal>
        <p class="t-eyebrow"><span class="idx">04</span> {c.eyebrow}</p>
        <h2 id="cfg-title" class="t-h2">{c.title}</h2>
      </div>
      <p class="cfg-intro" data-reveal style="--d:1">{c.text}</p>
    </div>

    <div class="cfg-layout">
      <div class="cfg-stage ticks" data-reveal>
        <div class="cfg-media">
          <img class="cfg-img is-active" data-layer src={first.src} srcset={first.srcset} sizes="(min-width: 1024px) 50vw, 92vw" width="800" height="500" alt={first.name[lang]} loading="lazy" decoding="async" />
          <img class="cfg-img" data-layer alt="" width="800" height="500" decoding="async" hidden />
          {
            items
              .filter((a) => a.drawing)
              .map((a) => (
                <div class="cfg-drawing" data-drawing={a.id} hidden>
                  <AttachmentDrawing kind={a.drawing!} title={`${a.name[lang]}: ${c.drawing.toLowerCase()}`} />
                </div>
              ))
          }
          <span class="cfg-counter t-mono" aria-hidden="true"><span data-cfg-index>01</span> / {String(items.length).padStart(2, '0')}</span>
        </div>
        <div class="cfg-info" aria-live="polite">
          <h3 class="t-h3 cfg-name" data-cfg-name>{first.name[lang]}</h3>
          <p class="cfg-text" data-cfg-text>{first.text[lang]}</p>
          <div class="cfg-compat">
            <span class="t-mono cfg-compat-k">{c.compatible}:</span>
            <span class="cfg-chips" data-cfg-compat>{first.compat.map((x) => <span class="chip">{x}</span>)}</span>
          </div>
          <p class="cfg-note t-mono" data-cfg-note hidden>{c.drawing}</p>
        </div>
      </div>

      <div class="cfg-picker">
        <ul class="cfg-grid no-scrollbar" role="list" data-cfg-grid>
          {
            items.map((a, i) => (
              <li>
                <button
                  type="button"
                  class="cfg-thumb"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-index={i}
                  data-name={a.name[lang]}
                  data-text={a.text[lang]}
                  data-compat={a.compat.join('|')}
                  data-src={a.src}
                  data-srcset={a.srcset}
                  data-drawing={a.drawing ? a.id : undefined}
                >
                  <span class="cfg-thumb-img">
                    {a.image ? (
                      <Image src={asset(a.image)} alt="" width={160} height={100} densities={[1, 2]} loading="lazy" />
                    ) : (
                      <AttachmentDrawing kind={a.drawing!} />
                    )}
                  </span>
                  <span class="cfg-thumb-name">{a.name[lang]}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <a href={route('attachments', lang)} class="link-arrow cfg-all">
          {c.all} <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-cfg]');
  if (root) {
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.cfg-thumb')];
    const layers = [...root.querySelectorAll<HTMLImageElement>('[data-layer]')];
    const drawings = [...root.querySelectorAll<HTMLElement>('[data-drawing]')].filter((el) => el.tagName === 'DIV');
    const nameEl = root.querySelector<HTMLElement>('[data-cfg-name]')!;
    const textEl = root.querySelector<HTMLElement>('[data-cfg-text]')!;
    const compatEl = root.querySelector<HTMLElement>('[data-cfg-compat]')!;
    const noteEl = root.querySelector<HTMLElement>('[data-cfg-note]')!;
    const indexEl = root.querySelector<HTMLElement>('[data-cfg-index]')!;
    let active = 0;
    let front = 0;

    const select = (i: number) => {
      if (i === active) return;
      active = i;
      const b = thumbs[i];
      thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
      nameEl.textContent = b.dataset.name ?? '';
      textEl.textContent = b.dataset.text ?? '';
      compatEl.replaceChildren(
        ...(b.dataset.compat ?? '').split('|').map((x) => Object.assign(document.createElement('span'), { className: 'chip', textContent: x }))
      );
      indexEl.textContent = String(i + 1).padStart(2, '0');
      const drawingId = b.dataset.drawing;
      noteEl.hidden = !drawingId;
      drawings.forEach((d) => d.toggleAttribute('hidden', d.dataset.drawing !== drawingId));
      if (drawingId) {
        layers.forEach((l) => l.classList.remove('is-active'));
        return;
      }
      // Crossfade: imaginea nouă se încarcă în stratul din spate, apoi trece în față.
      const back = layers[1 - front];
      const show = () => {
        if (active !== i) return;
        back.hidden = false;
        back.classList.add('is-active');
        layers[front].classList.remove('is-active');
        front = 1 - front;
      };
      back.alt = b.dataset.name ?? '';
      if (back.getAttribute('src') === b.dataset.src && back.complete) return show();
      back.onload = show;
      back.sizes = '(min-width: 1024px) 50vw, 92vw';
      back.srcset = b.dataset.srcset ?? '';
      back.src = b.dataset.src ?? '';
    };

    const hover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    thumbs.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      if (hover) {
        b.addEventListener('pointerenter', () => select(i));
        b.addEventListener('focus', () => select(i));
      }
    });
  }
</script>

<style>
  .cfg-titles { display: grid; gap: 1.1rem; }
  .cfg-intro { font-size: 1.0625rem; color: var(--color-steel-ink); max-width: 34rem; }
  .cfg-layout { display: grid; gap: 1.25rem; }

  .cfg-stage { display: grid; background-color: #fbfaf6; box-shadow: 0 0 0 1px var(--color-line-ink); padding: 1rem; gap: 1rem; }
  .cfg-media { position: relative; aspect-ratio: 8 / 5; overflow: hidden; }
  .cfg-img,
  .cfg-drawing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.45s ease,
      transform 0.7s var(--ease-hydraulic);
  }
  .cfg-img.is-active { opacity: 1; transform: none; }
  .cfg-drawing { display: grid; place-items: center; color: var(--color-asphalt); opacity: 1; transform: none; mix-blend-mode: normal; background: #fbfaf6; }
  .cfg-drawing :global(svg) { width: 86%; height: 86%; }
  .cfg-counter { position: absolute; top: 0.25rem; right: 0.25rem; font-size: 0.75rem; color: var(--color-steel-ink); }
  .cfg-counter span { color: var(--color-asphalt); font-weight: 500; }

  .cfg-info { display: grid; gap: 0.75rem; padding: 0 0.25rem 0.25rem; }
  .cfg-name { color: var(--color-asphalt); }
  .cfg-text { color: var(--color-steel-ink); min-height: 3.2em; }
  .cfg-compat { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cfg-compat-k { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-steel-ink); }
  .cfg-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .cfg-note { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-steel-ink); }

  .cfg-picker { display: grid; gap: 1.25rem; align-content: start; }
  .cfg-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 132px;
    gap: 6px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    padding-bottom: 6px;
  }
  .cfg-grid li { scroll-snap-align: start; }
  .cfg-thumb {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    padding: 6px 6px 8px;
    text-align: left;
    background: #fbfaf6;
    border: 0;
    box-shadow: inset 0 0 0 1px var(--color-line-ink);
    color: var(--color-asphalt);
    transition: box-shadow 0.2s, background-color 0.2s, transform 0.25s var(--ease-press);
  }
  .cfg-thumb:hover { box-shadow: inset 0 0 0 1.5px var(--color-asphalt); }
  .cfg-thumb:active { transform: scale(0.96); }
  .cfg-thumb[aria-pressed='true'] { background: var(--color-bull-yellow); box-shadow: inset 0 0 0 1.5px var(--color-asphalt); }
  .cfg-thumb-img { display: block; aspect-ratio: 8 / 5; overflow: hidden; }
  .cfg-thumb-img :global(img) { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .cfg-thumb-img :global(svg) { width: 100%; height: 100%; color: var(--color-asphalt); }
  .cfg-thumb-name { font-family: var(--font-mono); font-size: 0.6875rem; line-height: 1.3; letter-spacing: 0.02em; }

  @media (min-width: 64rem) {
    .cfg-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    .cfg-stage { position: sticky; top: calc(var(--header-h) + 1.5rem); padding: 1.5rem; }
    .cfg-grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }
</style>
