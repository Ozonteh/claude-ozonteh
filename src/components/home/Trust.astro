---
// „Distribuitor oficial BULL în Moldova" + bandă ticker + contoare animate (count-up la intrarea în viewport).
import BullLogo from '../ui/BullLogo.astro';
import { counters } from '../../data/site';
import { fmt } from '../../lib/products';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang).home.trust;
const ticker = [...ui.ticker, ...ui.ticker];
---

<section class="trust on-graphite" aria-labelledby="trust-title">
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        [0, 1].map(() => (
          <span class="ticker-group">
            {ticker.map((x) => (
              <>
                <span class="ticker-item">{x}</span>
                <span class="ticker-sep">◆</span>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="wrap section-tight trust-grid">
    <div class="trust-intro" data-reveal>
      <p class="t-eyebrow"><span class="idx">01</span> {ui.eyebrow}</p>
      <h2 id="trust-title" class="t-h2 trust-title">{ui.title}</h2>
      <p class="trust-text">{ui.text}</p>
      <div class="trust-logos">
        <BullLogo height={18} />
        <span class="t-mono trust-x" aria-hidden="true">×</span>
        <span class="t-mono trust-oz">Ozonteh Impex SRL</span>
      </div>
    </div>

    <dl class="counters" data-counters>
      {
        counters.map((c, i) => (
          <div class="counter" data-reveal style={`--d:${i}`}>
            <dt class="counter-k">{ui.counters[c.key]}</dt>
            <dd class="counter-v t-num">
              <span data-count={c.value} data-lang={lang}>{fmt(c.value, lang)}</span>
              {c.suffix && <span class="counter-plus">{c.suffix}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // Count-up: valoarea finală e deja în HTML (SEO, fără JS); animăm doar dacă e permis.
  const box = document.querySelector('[data-counters]');
  if (box && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const els = [...box.querySelectorAll<HTMLElement>('[data-count]')];
    const nf = new Intl.NumberFormat(document.documentElement.lang === 'ru' ? 'ru-RU' : 'ro-RO');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        els.forEach((el) => (el.textContent = '0'));
        const t0 = performance.now();
        const dur = 1800;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          const k = 1 - Math.pow(1 - p, 4);
          els.forEach((el) => (el.textContent = nf.format(Math.round(Number(el.dataset.count) * k)).replace(/ /g, ' ')));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );
    io.observe(box);
  }
</script>

<style>
  .trust { position: relative; }
  .ticker {
    overflow: hidden;
    background: var(--color-bull-yellow);
    color: var(--color-asphalt);
    border-block: 6px solid transparent;
    border-image: repeating-linear-gradient(-45deg, var(--color-asphalt) 0 8px, var(--color-bull-yellow) 8px 16px) 6;
  }
  .ticker-track { display: flex; width: max-content; animation: ticker 38s linear infinite; }
  .ticker-group { display: flex; align-items: center; flex: none; }
  .ticker-item {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(1.5rem * var(--display-scale) / 0.85);
    text-transform: uppercase;
    padding: 0.55rem 1.25rem;
    white-space: nowrap;
    line-height: 1;
  }
  :global(html:lang(ru)) .ticker-item { font-weight: 600; font-size: 1.15rem; }
  .ticker-sep { font-size: 0.6rem; }

  .trust-grid { display: grid; gap: 3rem; }
  .trust-intro { display: grid; gap: 1.25rem; align-content: start; }
  .trust-text { color: color-mix(in oklab, var(--color-bone) 85%, transparent); max-width: 38rem; }
  .trust-logos { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem; }
  .trust-x { color: var(--color-bull-yellow); }
  .trust-oz { font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .counters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-line); box-shadow: 0 0 0 1px var(--color-line); }
  .counter { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.6rem; padding: 1.4rem 1rem 1.25rem; background: var(--color-graphite); min-width: 0; }
  .counter:last-child { grid-column: 1 / -1; }
  .counter-v { font-size: clamp(2.6rem, 1.9rem + 3vw, 4.5rem); color: var(--color-bone); white-space: nowrap; }
  :global(html:lang(ru)) .counter-v { font-size: clamp(2.1rem, 1.6rem + 2.2vw, 3.6rem); }
  .counter-plus { color: var(--color-bull-yellow); }
  .counter-k { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-steel); line-height: 1.4; }

  @media (min-width: 64rem) {
    .trust-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 4rem; align-items: center; }
    .counters { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .counter { grid-column: span 2; padding: 2rem 1.5rem 1.75rem; }
    .counter:nth-child(n + 4) { grid-column: span 3; }
    .counter:last-child { grid-column: span 3; }
  }
</style>
