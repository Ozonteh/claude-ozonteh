---
// Logo BULL vectorial (furnizat de Ozonteh).
// variant „invers": taurul în culoarea hârtiei, pentru fundaluri închise; „color": originalul, pentru fundaluri deschise.
// inline: SVG direct în HTML (header, fără cerere suplimentară); altfel <img> lazy, cache-uit.
import BullInvers from '../../assets/brand/bull-logo-invers.svg';
import BullColor from '../../assets/brand/bull-logo.svg';
interface Props { height?: number; variant?: 'invers' | 'color'; class?: string; inline?: boolean }
const { height = 16, variant = 'invers', class: cls, inline = false } = Astro.props;
const Logo = variant === 'color' ? BullColor : BullInvers;
const width = Math.round((200 / 39) * height);
---
{
  inline ? (
    <Logo width={width} height={height} class={cls} aria-label="BULL Machines" focusable="false" />
  ) : (
    <img src={Logo.src} width={width} height={height} class={cls} alt="BULL Machines" loading="lazy" decoding="async" />
  )
}
