---
// Breadcrumbs vizibile (schema BreadcrumbList se generează separat, în lib/schema.ts).
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { lang: Lang; crumbs: { name: string; url: string }[] }
const { lang, crumbs } = Astro.props;
const path = (u: string) => (u.startsWith('http') ? new URL(u).pathname : u);
---

<nav class="crumbs" aria-label={t(lang).product.breadcrumb}>
  <ol>
    {
      crumbs.map((c, i) => (
        <li>{i < crumbs.length - 1 ? <a href={path(c.url)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-steel); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .crumbs li + li::before { content: '/'; color: rgb(138 144 153 / 0.5); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-steel); }
  .crumbs a:hover { color: var(--color-bull-yellow); }
  .crumbs [aria-current] { color: var(--color-bone); }
</style>
