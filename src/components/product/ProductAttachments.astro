---
// Cupe și atașamente compatibile cu tipul de utilaj (buldoexcavator / încărcător frontal / skid steer).
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import AttachmentDrawing from '../home/AttachmentDrawing.astro';
import { asset } from '../../lib/images';
import { attachments } from '../../data/attachments';
import type { Product } from '../../lib/products';
import { route, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { p: Product; lang: Lang }
const { p, lang } = Astro.props;
const a = t(lang).product.attachments;
const kind = p.category === 'buldoexcavatoare' ? 'backhoe' : p.category === 'incarcatoare-frontale' ? 'loader' : 'skid';
const list = attachments.filter((x) => x.for.includes(kind)).slice(0, 8);
---

{
  list.length > 0 && (
    <section class="att band on-graphite section" aria-labelledby="att-title">
      <div class="att-head" data-reveal>
        <p class="t-eyebrow">
          <span class="idx">05</span> {a.eyebrow}
        </p>
        <h2 id="att-title" class="t-h2 att-title">{a.title}</h2>
        <p class="t-body-muted att-text">{a.text}</p>
      </div>
      <ul class="att-grid no-scrollbar" role="list">
        {list.map((x, i) => (
          <li class="att-card" data-reveal style={`--d:${i % 4}`}>
            <div class="att-media">
              {x.image ? (
                <Image src={asset(x.image)} alt={x.name[lang]} widths={[240, 400]} sizes="(min-width: 1024px) 200px, 60vw" loading="lazy" />
              ) : (
                <AttachmentDrawing kind={x.drawing!} title={x.name[lang]} class="att-drawing" />
              )}
            </div>
            <h3 class="att-name">{x.name[lang]}</h3>
            <p class="att-desc">{x.text[lang]}</p>
          </li>
        ))}
      </ul>
      <a href={route('attachments', lang)} class="link-arrow att-all">
        {a.all} <Icon name="arrow" size={18} />
      </a>
    </section>
  )
}

<style>
  .att { display: grid; gap: clamp(1.75rem, 1.25rem + 2vw, 3rem); }
  .att-head { display: grid; gap: 1.1rem; max-width: 46rem; }
  .att-title { font-size: calc(clamp(2.1rem, 1.4rem + 3vw, 4.5rem) * var(--display-scale)); }
  .att-text { font-size: 0.9375rem; }
  .att-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(64vw, 240px);
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .att-card { display: grid; gap: 0.5rem; align-content: start; scroll-snap-align: start; padding: 10px 10px 1rem; background: var(--color-asphalt); box-shadow: inset 0 0 0 1px var(--color-line); }
  .att-media { display: grid; place-items: center; aspect-ratio: 4 / 3; padding: 10px; margin-bottom: 0.4rem; background-color: #fff; }
  .att-media:has(svg) { background-color: rgb(255 255 255 / 0.02); }
  .att-media :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .att-media :global(.att-drawing) { width: 100%; height: 100%; color: var(--color-bull-yellow); }
  .att-name { font-weight: 600; font-size: 1rem; line-height: 1.25; }
  .att-desc { font-size: 0.8125rem; line-height: 1.45; color: var(--color-steel); }
  .att-all { justify-self: start; }
  @media (min-width: 64rem) {
    .att-grid { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; margin: 0; padding: 0; }
  }
</style>
