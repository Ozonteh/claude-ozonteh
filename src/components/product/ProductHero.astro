---
// Hero-ul paginii de produs: breadcrumbs, H1 (tip + model), imaginea decupată pe planșă blueprint,
// garanția, CTA-urile cu modelul preselectat și galeria foto (lightbox cu <dialog> nativ).
import { Image, Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import WarrantyBadges from '../ui/WarrantyBadges.astro';
import { asset } from '../../lib/images';
import { fmt, type Product } from '../../lib/products';
import { company } from '../../data/site';
import type { Lang } from '../../i18n/routes';
import { t, tpl } from '../../i18n/ui';

interface Props {
  p: Product;
  lang: Lang;
  photos: string[];
  crumbs: { name: string; url: string }[];
}
const { p, lang, photos, crumbs } = Astro.props;
const ui = t(lang);
const u = ui.product;
const wa = `${company.whatsapp}?text=${encodeURIComponent(tpl(u.waText, { model: p.name }))}`;
const THUMBS = 4;
const thumbs = photos.slice(0, THUMBS);
const more = photos.length - THUMBS;
const len = p.drawing?.views.flatMap((v) => v.dims).find((d) => d[1] === 'length');
const lengthLabel = len ? `${fmt(len[2], lang, p.drawing!.unit === 'm' ? 2 : 0)} ${p.drawing!.unit === 'm' ? ui.units.m : ui.units.mm}` : null;
// Watermark-ul modelului e text SVG: se scalează în scenă și nu devine element LCP (imaginea rămâne LCP).
const wmW = Math.round(p.model.length * 52);
const photoAlt = (i: number) => `${p.alt[lang]}. ${tpl(u.photoOf, { i: i + 1, n: photos.length })}`;
---

<section class="ph on-dark" aria-labelledby="ph-title">
  <div class="ph-grid blueprint" aria-hidden="true"></div>
  <div class="wrap ph-inner">
    <nav class="crumbs" aria-label={u.breadcrumb}>
      <ol>
        {
          crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={new URL(c.url).pathname}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="ph-head">
      {p.isNew && <p class="ph-new"><span class="badge badge-new">{ui.badges.new}</span></p>}
      <h1 id="ph-title" class="ph-title">
        <span class="ph-kicker">{p.type[lang]}</span>
        <span class="ph-name">{p.name}</span>
      </h1>
    </div>

    <div class="ph-media">
      <div class="ph-stage">
        <svg class="ph-watermark" viewBox={`0 0 ${wmW} 100`} aria-hidden="true" focusable="false">
          <text x="50%" y="86" text-anchor="middle" textLength={wmW - 8} lengthAdjust="spacingAndGlyphs">{p.model}</text>
        </svg>
        <Picture
          src={asset(p.image)}
          alt={p.alt[lang]}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1440px) 760px, (min-width: 1024px) 54vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="ph-img"
        />
        {
          lengthLabel && (
            <p class="dim ph-dim" aria-hidden="true">
              <span class="dim-k">A</span>
              <span>{lengthLabel}</span>
            </p>
          )
        }
      </div>
      {
        photos.length > 0 && (
          <ul class="ph-thumbs" role="list" aria-label={u.gallery}>
            {thumbs.map((src, i) => (
              <li>
                <button type="button" class="ph-thumb" data-lb-open={i} aria-label={`${u.galleryOpen}: ${tpl(u.photoOf, { i: i + 1, n: photos.length })}`}>
                  <Image src={asset(src)} alt="" widths={[160, 320]} sizes="(min-width: 1024px) 140px, 23vw" loading="lazy" />
                  {i === THUMBS - 1 && more > 0 && <span class="ph-more t-mono">+{more}</span>}
                </button>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="ph-copy">
      <p class="t-lead ph-lead">{p.summary[lang]}</p>
      <WarrantyBadges lang={lang} />
      <div class="ph-cta">
        <button type="button" class="btn btn-primary btn-lg" data-quote data-model={p.id} data-magnetic>
          {ui.cta.quote} <Icon name="arrow" class="arrow" />
        </button>
        <button type="button" class="btn btn-outline btn-lg" data-quote data-demo data-model={p.id}>
          <Icon name="calendar" /> {u.demo}
        </button>
      </div>
      <div class="ph-contact" data-track-loc="product-hero">
        <a href={`tel:${company.phone.tel}`} class="ph-phone t-mono"><Icon name="phone" /> {company.phone.display}</a>
        <a href={wa} class="ph-wa" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
      <p class="ph-note t-mono">{u.priceOnRequest} · {ui.home.final.leasing}</p>
    </div>
  </div>
</section>

{
  photos.length > 0 && (
    <dialog class="lb" data-lightbox aria-label={`${u.gallery}: ${p.name}`}>
      <div class="lb-bar">
        <p class="t-mono lb-count" aria-live="polite">
          <span data-lb-index>1</span> / {photos.length}
        </p>
        <button type="button" class="lb-btn" data-lb-close aria-label={ui.a11y.close}>
          <Icon name="close" />
        </button>
      </div>
      <ul class="lb-track no-scrollbar" role="list" data-lb-track>
        {photos.map((src, i) => (
          <li class="lb-slide">
            <Image src={asset(src)} alt={photoAlt(i)} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="lazy" class="lb-img" />
          </li>
        ))}
      </ul>
      <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={ui.a11y.prev}>
        <Icon name="arrow" />
      </button>
      <button type="button" class="lb-btn lb-next" data-lb-next aria-label={ui.a11y.next}>
        <Icon name="arrow" />
      </button>
    </dialog>
  )
}

<style>
  .ph { position: relative; overflow: hidden; isolation: isolate; padding-top: calc(var(--header-h) + 0.75rem); padding-bottom: clamp(2rem, 1rem + 3vw, 4rem); }
  .ph-grid { position: absolute; inset: 0; z-index: -1; mask-image: radial-gradient(120% 90% at 70% 40%, #000 30%, transparent 85%); }
  .ph-inner {
    display: grid;
    grid-template-areas: 'crumbs' 'head' 'media' 'copy';
    gap: 1.25rem;
  }
  .crumbs { grid-area: crumbs; }
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-steel); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .crumbs li + li::before { content: '/'; color: rgb(138 144 153 / 0.5); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 32px; color: var(--color-steel); }
  .crumbs a:hover { color: var(--color-bull-yellow); }
  .crumbs [aria-current] { color: var(--color-bone); }

  .ph-head { grid-area: head; display: grid; gap: 0.9rem; }
  .ph-new { line-height: 1; }
  .ph-title { display: grid; gap: 0.5rem; margin: 0; }
  .ph-kicker { font-family: var(--font-mono); font-weight: 500; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-bull-yellow); }
  .ph-name {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--display-track);
    font-size: calc(clamp(2.9rem, 1.6rem + 5.2vw, 6.75rem) * var(--display-scale));
    line-height: 0.86;
    text-wrap: balance;
  }
  :global(html:lang(ru)) .ph-name { font-weight: 600; line-height: 0.98; }

  .ph-media { grid-area: media; display: grid; gap: 10px; min-width: 0; }
  .ph-stage { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; margin-inline: calc(var(--gutter) * -0.5); }
  .ph-watermark {
    position: absolute;
    inset: 6% 0 auto;
    width: 100%;
    max-height: 48%;
    pointer-events: none;
    overflow: visible;
  }
  .ph-watermark text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 100px;
    text-transform: uppercase;
    fill: none;
    stroke: rgb(255 194 14 / 0.24);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  :global(html:lang(ru)) .ph-watermark text { font-weight: 600; }
  .ph-stage :global(picture) { position: relative; display: block; width: 100%; height: 100%; }
  .ph-stage :global(.ph-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 28px 30px rgb(0 0 0 / 0.55));
    animation: ph-in 1.1s var(--ease-hydraulic) both;
  }
  /* Doar transform, fără opacitate: imaginea e vizibilă din primul frame (LCP). */
  @keyframes ph-in { from { transform: translate3d(3%, 0, 0) scale(0.97); } }
  .ph-dim { position: absolute; inset: auto 8% 2% 8%; }
  .ph-dim span:last-child { text-transform: none; }

  .ph-thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .ph-thumb { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; background: var(--color-graphite); cursor: zoom-in; }
  .ph-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) brightness(0.85); transition: transform 0.6s var(--ease-hydraulic), filter 0.3s; }
  .ph-thumb:hover :global(img) { transform: scale(1.06); filter: none; }
  .ph-thumb:focus-visible { outline-offset: -3px; }
  .ph-more { position: absolute; inset: 0; display: grid; place-items: center; font-size: 1.125rem; color: var(--color-bone); background: rgb(18 19 20 / 0.62); }

  .ph-copy { grid-area: copy; display: grid; gap: 1.1rem; align-content: start; }
  .ph-lead { max-width: 38rem; }
  .ph-cta { display: grid; gap: 8px; margin-top: 0.25rem; }
  .ph-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  .ph-phone { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; font-size: 1.125rem; color: var(--color-bull-yellow); }
  .ph-wa { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; font-weight: 600; color: var(--color-bone); }
  .ph-wa :global(svg) { color: #25d366; }
  .ph-phone:hover, .ph-wa:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ph-note { font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-steel); }

  @media (min-width: 40rem) {
    .ph-cta { grid-auto-flow: column; justify-content: start; }
  }
  @media (min-width: 64rem) {
    .ph { padding-top: calc(var(--header-h) + 1.5rem); }
    .ph-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: 'crumbs crumbs' 'head media' 'copy media';
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2rem, 1rem + 3vw, 5rem);
      row-gap: 1.75rem;
    }
    .ph-head { align-self: end; padding-top: 1.5rem; }
    .ph-media { align-self: center; }
    .ph-stage { margin-inline: 0; aspect-ratio: 16 / 11; }
    .ph-thumbs { grid-template-columns: repeat(4, 140px); justify-content: end; }
  }

  /* Lightbox */
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-bone);
    background: rgb(12 13 14 / 0.97);
    opacity: 0;
    transition: opacity 0.3s, overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }
  .lb[open] { opacity: 1; display: grid; grid-template-rows: auto 1fr; }
  @starting-style { .lb[open] { opacity: 0; } }
  .lb::backdrop { background: transparent; }
  .lb-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem var(--gutter); padding-top: max(0.5rem, env(safe-area-inset-top)); }
  .lb-count { font-size: 0.8125rem; color: var(--color-steel); }
  .lb-track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
  .lb-slide { display: grid; place-items: center; scroll-snap-align: center; padding: 0 var(--gutter) 1.5rem; min-height: 0; }
  .lb-slide :global(.lb-img) { max-width: 100%; max-height: calc(100dvh - 7rem); width: auto; height: auto; object-fit: contain; }
  .lb-btn { display: grid; place-items: center; width: 52px; height: 52px; padding: 0; border: 0; color: var(--color-bone); background: rgb(30 32 34 / 0.85); box-shadow: inset 0 0 0 1px var(--color-line); }
  .lb-btn:hover { background: var(--color-bull-yellow); color: var(--color-asphalt); }
  .lb-prev, .lb-next { position: fixed; top: 50%; translate: 0 -50%; display: none; }
  .lb-prev { left: var(--gutter); }
  .lb-prev :global(svg) { transform: scaleX(-1); }
  .lb-next { right: var(--gutter); }
  @media (min-width: 64rem) and (pointer: fine) {
    .lb-prev, .lb-next { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-stage :global(.ph-img) { animation: none; }
  }
</style>
