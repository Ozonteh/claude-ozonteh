---
// Avantaje (din products.json), versiunile vândute în Moldova (ex. HD 100) și textul lung
// al modelului (Markdown din src/content/produse, introdus prin slot).
import Icon from '../ui/Icon.astro';
import type { Product } from '../../lib/products';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { p: Product; lang: Lang }
const { p, lang } = Astro.props;
const u = t(lang).product;
---

<section class="ov band on-light section" aria-labelledby="ov-title">
  <div class="ov-head" data-reveal>
    <p class="t-eyebrow"><span class="idx">02</span> {u.advantages}</p>
    <h2 id="ov-title" class="t-h2 ov-title">{p.tagline[lang]}</h2>
  </div>

  <ol class="ov-adv" role="list">
    {
      p.advantages.map((a, i) => (
        <li class="ov-adv-item" data-reveal style={`--d:${i % 3}`}>
          <span class="t-mono ov-adv-n">{String(i + 1).padStart(2, '0')}</span>
          <p>{a[lang]}</p>
        </li>
      ))
    }
  </ol>

  {
    p.variants && (
      <div class="ov-variants">
        <h3 class="t-h3">{u.variants}</h3>
        <div class="ov-var-grid">
          {p.variants.map((v, i) => (
            <article class="ov-var ticks" data-reveal style={`--d:${i}`}>
              <h4 class="ov-var-name">
                <span class="t-mono ov-var-idx">{String.fromCharCode(65 + i)}</span> {v.name[lang]}
              </h4>
              <ul class="ov-var-list" role="list">
                {v.points.map((pt) => (
                  <li>
                    <Icon name="check" size={16} /> {pt[lang]}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <p class="ov-var-note t-mono">{u.variantsNote}</p>
      </div>
    )
  }

  <div class="ov-prose prose" data-reveal>
    <slot />
  </div>
</section>

<style>
  .ov { display: grid; gap: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .ov-head { display: grid; gap: 1.1rem; max-width: 52rem; }
  .ov-title { font-size: calc(clamp(2.1rem, 1.4rem + 3vw, 4.5rem) * var(--display-scale)); }

  .ov-adv { display: grid; gap: 1px; background: var(--color-line-ink); box-shadow: 0 0 0 1px var(--color-line-ink); }
  .ov-adv-item { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding: 1.1rem 1rem; background: var(--color-paper); }
  .ov-adv-item p { font-weight: 600; line-height: 1.4; }
  .ov-adv-n { display: grid; place-items: center; width: 34px; height: 34px; font-size: 0.75rem; color: var(--color-asphalt); background: var(--color-bull-yellow); }

  .ov-variants { display: grid; gap: 1.25rem; }
  .ov-var-grid { display: grid; gap: 10px; }
  .ov-var { display: grid; gap: 1rem; align-content: start; padding: 1.4rem 1.25rem 1.5rem; color: var(--color-bone); background: var(--color-asphalt); }
  .ov-var-name { display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: 1.5rem; line-height: 1; letter-spacing: var(--display-track); }
  :global(html:lang(ru)) .ov-var-name { font-weight: 600; font-size: 1.3rem; }
  .ov-var-idx { display: grid; place-items: center; width: 32px; height: 32px; flex: none; font-size: 0.875rem; color: var(--color-asphalt); background: var(--color-bull-yellow); }
  .ov-var-list { display: grid; gap: 0.55rem; }
  .ov-var-list li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.4; }
  .ov-var-list :global(svg) { flex: none; margin-top: 3px; color: var(--color-bull-yellow); }
  .ov-var-note { font-size: 0.75rem; color: var(--color-steel-ink); }

  .ov-prose { max-width: 46rem; }

  @media (min-width: 48rem) {
    .ov-adv { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ov-adv-item:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .ov-var-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
