---
import Icon from '../ui/Icon.astro';
import OzontehLogo from '../ui/OzontehLogo.astro';
import BullLogo from '../ui/BullLogo.astro';
import { company } from '../../data/site';
import { products } from '../../lib/products';
import { route, productPath, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
const companyLinks = [
  { href: route('catalog', lang), label: ui.nav.catalog },
  { href: route('compare', lang), label: ui.nav.compare },
  { href: route('attachments', lang), label: ui.nav.attachments },
  { href: route('service', lang), label: ui.nav.service },
  { href: route('about', lang), label: ui.nav.about },
  { href: route('blog', lang), label: ui.nav.blog },
  { href: route('contact', lang), label: ui.nav.contact },
];
const socials = [
  { href: company.social.facebook, icon: 'facebook', label: 'Facebook' },
  { href: company.social.instagram, icon: 'instagram', label: 'Instagram' },
  { href: company.social.tiktok, icon: 'tiktok', label: 'TikTok' },
  { href: company.social.youtube, icon: 'youtube', label: 'YouTube' },
  { href: company.social.telegram, icon: 'telegram', label: 'Telegram' },
].filter((s) => s.href) as { href: string; icon: 'facebook'; label: string }[];
---

<footer class="footer cv-auto">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div class="f-brand">
      <a href={route('home', lang)} aria-label={ui.a11y.home} class="f-logo"><OzontehLogo height={30} /></a>
      <p class="f-tagline">{ui.footer.tagline}</p>
      <div class="f-official">
        <BullLogo height={18} />
        <span class="badge badge-warranty"><Icon name="shield" /> {ui.badges.warranty}</span>
      </div>
      {
        socials.length > 0 && (
          <div class="f-social" aria-label={ui.footer.follow}>
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <Icon name={s.icon} size={20} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <nav class="f-col" aria-labelledby="f-machines">
      <p id="f-machines" class="f-title">{ui.footer.machines}</p>
      <ul role="list">
        {products.map((p) => <li><a href={productPath(p, lang)}>{p.name}</a></li>)}
      </ul>
    </nav>

    <nav class="f-col" aria-labelledby="f-company">
      <p id="f-company" class="f-title">{ui.footer.company}</p>
      <ul role="list">
        {companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="f-col f-contact">
      <p class="f-title">{ui.footer.contact}</p>
      <a href={`tel:${company.phone.tel}`} class="f-phone t-mono" data-track-loc="footer">{company.phone.intl}</a>
      <a href={company.whatsapp} target="_blank" rel="noopener" class="f-line" data-track-loc="footer"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      <a href={`mailto:${company.email}`} class="f-line"><Icon name="mail" size={18} /> {company.email}</a>
      <p class="f-line">
        <Icon name="pin" size={18} />
        <span>
          <span class="f-sub">{ui.footer.hq}</span>
          <span>{company.address.street}</span>,
          <span>{company.address.locality}</span>,
          <span>{company.address.countryName[lang]}</span>
        </span>
      </p>
      <div class="f-line">
        <Icon name="clock" size={18} />
        <span>
          <span class="f-sub">{ui.footer.hoursTitle}</span>
          {ui.footer.hours.map((h) => <span class="f-hour">{h}</span>)}
        </span>
      </div>
    </div>
  </div>

  <div class="wrap f-bottom">
    <p>© {year} {ui.footer.rights}</p>
    <p class="f-tm">{ui.footer.trademark}</p>
    <div class="f-legal">
      <a href={route('privacy', lang)}>{ui.nav.privacy}</a>
      <a href={route('cookies', lang)}>{ui.nav.cookies}</a>
      <button type="button" data-consent-open>{ui.consent.manage}</button>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-asphalt); color: var(--color-bone); position: relative; }
  .footer-grid { display: grid; gap: 2.5rem; padding-block: 3.5rem 2.5rem; }
  .f-logo { display: inline-flex; min-height: 48px; align-items: center; }
  .f-tagline { margin-top: 1rem; color: var(--color-steel); max-width: 34ch; }
  .f-official { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.25rem; }
  .f-social { display: flex; gap: 6px; margin-top: 1.5rem; }
  .f-social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-bone);
    transition: color 0.2s, box-shadow 0.2s;
  }
  .f-social a:hover { color: var(--color-bull-yellow); box-shadow: inset 0 0 0 1px var(--color-bull-yellow); }
  .f-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bull-yellow);
    margin-bottom: 0.9rem;
  }
  .f-col ul { display: grid; }
  .f-col ul a { display: inline-flex; align-items: center; min-height: 40px; color: var(--color-bone); font-size: 0.9375rem; }
  .f-col ul a:hover { color: var(--color-bull-yellow); }
  .f-contact { display: grid; gap: 0.75rem; align-content: start; }
  .f-phone { font-size: 1.375rem; color: var(--color-bull-yellow); min-height: 44px; display: inline-flex; align-items: center; }
  .f-line { display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.9375rem; min-height: 32px; }
  .f-line :global(svg) { flex: none; margin-top: 3px; color: var(--color-steel); }
  a.f-line:hover { color: var(--color-bull-yellow); }
  .f-sub { display: block; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-steel); }
  .f-hour { display: block; }
  .f-bottom {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    color: var(--color-steel);
  }
  .f-legal { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .f-legal a, .f-legal button { min-height: 40px; display: inline-flex; align-items: center; color: var(--color-steel); background: none; border: 0; font: inherit; padding: 0; text-decoration: underline; text-underline-offset: 3px; }
  .f-legal a:hover, .f-legal button:hover { color: var(--color-bone); }

  @media (min-width: 48rem) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 64rem) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: 3rem; padding-block: 5rem 3.5rem; }
    .f-bottom { grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; }
  }
</style>
