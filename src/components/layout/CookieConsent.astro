---
// Banner GDPR. GA4 (analiză) și Meta/TikTok Pixel (marketing) se încarcă DOAR după acord
// (logica în src/scripts/consent.ts). Alegerea se păstrează în localStorage.
import { route, type Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang).consent;
---

<section class="consent" role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-text" data-consent hidden>
  <div class="consent-card">
    <p id="consent-title" class="consent-title">{ui.title}</p>
    <p id="consent-text" class="consent-text">
      {ui.text} <a href={route('cookies', lang)} class="prose-links">{t(lang).nav.cookies}</a>.
    </p>

    <div class="consent-prefs" data-consent-prefs hidden>
      <label class="pref">
        <span><strong>{ui.necessaryLabel}</strong><small>{ui.necessaryHint}</small></span>
        <input type="checkbox" class="switch" checked disabled />
      </label>
      <label class="pref">
        <span><strong>{ui.analyticsLabel}</strong><small>{ui.analyticsHint}</small></span>
        <input type="checkbox" class="switch" name="analytics" data-consent-analytics />
      </label>
      <label class="pref">
        <span><strong>{ui.marketingLabel}</strong><small>{ui.marketingHint}</small></span>
        <input type="checkbox" class="switch" name="marketing" data-consent-marketing />
      </label>
    </div>

    <div class="consent-actions">
      <button type="button" class="btn btn-primary btn-sm" data-consent-accept>{ui.acceptAll}</button>
      <button type="button" class="btn btn-outline btn-sm" data-consent-necessary>{ui.necessary}</button>
      <button type="button" class="btn btn-ghost btn-sm" data-consent-settings aria-expanded="false">{ui.settings}</button>
      <button type="button" class="btn btn-outline btn-sm" data-consent-save hidden>{ui.save}</button>
    </div>
  </div>
</section>

<style>
  .consent {
    position: fixed;
    z-index: 70;
    left: 8px;
    right: 8px;
    bottom: calc(var(--bar-h) + env(safe-area-inset-bottom) + 8px);
    animation: fade-up 0.5s var(--ease-hydraulic) both;
  }
  .consent-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.1rem 1.1rem 1rem;
    background: var(--color-graphite);
    box-shadow: inset 0 0 0 1px var(--color-line), inset 0 3px 0 var(--color-bull-yellow), 0 20px 50px rgb(0 0 0 / 0.5);
    max-height: calc(100dvh - var(--bar-h) - 32px);
    overflow-y: auto;
  }
  .consent-title { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-bull-yellow); }
  .consent-text { font-size: 0.875rem; line-height: 1.5; color: var(--color-bone); }
  .consent-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .consent-actions .btn { flex: 1 1 auto; }
  .consent-prefs { display: grid; gap: 2px; }
  .pref {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-asphalt);
    cursor: pointer;
  }
  .pref strong { display: block; font-size: 0.9375rem; }
  .pref small { display: block; font-size: 0.8125rem; color: var(--color-steel); line-height: 1.4; }
  @media (min-width: 48rem) {
    .consent { left: auto; right: 24px; bottom: 24px; width: 440px; }
  }
</style>
