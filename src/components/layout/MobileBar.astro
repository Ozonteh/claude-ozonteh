---
// Bară fixă jos pe mobil: Sună · WhatsApp · Cere ofertă (butoane ≥ 48 px).
import Icon from '../ui/Icon.astro';
import { company } from '../../data/site';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
interface Props { lang: Lang; model?: string }
const ui = t(Astro.props.lang);
---
<nav class="mobile-bar" aria-label={ui.menu.contact}>
  <a href={`tel:${company.phone.tel}`} class="mb-btn" data-track-loc="mobile-bar">
    <Icon name="phone" size={20} /><span>{ui.cta.callShort}</span>
  </a>
  <a href={company.whatsapp} class="mb-btn mb-wa" target="_blank" rel="noopener" data-track-loc="mobile-bar">
    <Icon name="whatsapp" size={20} /><span>{ui.cta.whatsapp}</span>
  </a>
  <button type="button" class="mb-btn mb-quote" data-quote data-model={Astro.props.model}>
    <Icon name="quote" size={20} /><span>{ui.cta.quote}</span>
  </button>
</nav>
<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 1px;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-line);
    box-shadow: 0 -10px 30px rgb(0 0 0 / 0.35);
    transition: transform 0.4s var(--ease-hydraulic);
  }
  .mobile-bar[data-hidden] { transform: translateY(110%); }
  .mb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 64px;
    padding: 0 0.4rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.1;
    color: var(--color-bone);
    background: var(--color-asphalt);
    border: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform 0.2s var(--ease-press), box-shadow 0.15s;
  }
  .mb-btn:active { transform: scale(0.96); box-shadow: inset 0 4px 10px rgb(0 0 0 / 0.55); }
  .mb-wa :global(svg) { color: #25d366; }
  .mb-quote { background: var(--color-bull-yellow); color: var(--color-asphalt); }
  .mb-quote:active { box-shadow: inset 0 4px 0 rgb(0 0 0 / 0.22); }
  @media (min-width: 64rem) {
    .mobile-bar { display: none; }
  }
</style>
