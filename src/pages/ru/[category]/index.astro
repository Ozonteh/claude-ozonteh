---
// Paginile de categorie, RU: /ru/ekskavatory-pogruzchiki/, /ru/frontalnye-pogruzchiki/, /ru/mini-pogruzchiki/
import CategoryPage from '../../../views/CategoryPage.astro';
import { CATEGORY_SLUGS, type CategoryId } from '../../../i18n/routes';

export function getStaticPaths() {
  return (Object.keys(CATEGORY_SLUGS) as CategoryId[]).map((cat) => ({ params: { category: CATEGORY_SLUGS[cat].ru }, props: { cat } }));
}
const { cat } = Astro.props;
---

<CategoryPage lang="ru" cat={cat} />
