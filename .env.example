# Copiați în .env (local) sau setați în Netlify → Site settings → Environment variables.

# Domeniul final al site-ului (canonical, hreflang, sitemap, Open Graph)
PUBLIC_SITE_URL=https://bull.ozonteh.md

# Analytics — se încarcă DOAR după acordul din bannerul de cookie-uri
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=

# Endpoint formular (implicit funcția Netlify /api/lead)
# PUBLIC_LEAD_ENDPOINT=/api/lead

# amoCRM (contul Ozonteh): integrare privată → token de lungă durată
AMOCRM_BASE_URL=https://ozonteh.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RESPONSIBLE_USER_ID=
# Alternativ: un webhook (Make/Zapier/integrare amoCRM) care primește lead-ul ca JSON
LEAD_WEBHOOK_URL=

# E-mail de rezervă (Resend) dacă amoCRM nu răspunde
RESEND_API_KEY=
LEAD_EMAIL_TO=office@ozonteh.md
LEAD_EMAIL_FROM=BULL Moldova <site@bull.ozonteh.md>
